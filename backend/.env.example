# 이 파일을 복사해 backend/.env 로 만들고 값을 채웁니다. (.env 는 저장소에 올리지 않습니다)

# --- Firebase 서비스 계정 키 (둘 중 하나만 채우면 됩니다) ---
# 로컬: 내려받은 JSON 키 파일의 경로 (이 폴더 밖에 두거나 .gitignore 된 이름 사용)
FIREBASE_SERVICE_ACCOUNT_PATH=
# 배포(Render): JSON 파일 내용을 한 줄로 붙여 넣기
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- OpenAI 호환 API (교육장 제공) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini

# --- Anthropic 호환 API (책 사진 읽기용. OpenAI 호환 키와는 별도 키) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr/v1
ANTHROPIC_VISION_MODEL=claude-sonnet-4

# --- CORS: 프론트 주소를 쉼표로 구분 (로컬 + Vercel 배포 주소) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
