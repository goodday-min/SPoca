# 이 파일을 복사해 backend/.env 로 만들고 값을 채웁니다. (.env 는 저장소에 올리지 않습니다)

# Firebase 서비스 계정 키 (JSON 파일 내용을 한 줄로 붙여 넣기)
FIREBASE_SERVICE_ACCOUNT_JSON=

# OpenAI
OPENAI_API_KEY=
# 사용할 모델명 (T1-8 채팅 구현 때 정함)
OPENAI_MODEL=

# CORS: 프론트 주소를 쉼표로 구분 (로컬 + Vercel 배포 주소)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
